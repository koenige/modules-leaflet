#: configuration/package.cfg:13
msgid "leaflet module"
msgstr "Leaflet-Modul"

#: configuration/package.cfg:15
msgid "Embed interactive maps using the Leaflet JavaScript library"
msgstr ""
"Interaktive Karten mithilfe der JavaScript-Bibliothek „Leaflet“ einbetten"

#: configuration/settings.cfg:20
msgid "Relative path to Leaflet (and plugin) dist CSS/JS under behaviour_path"
msgstr ""
"Relativer Pfad zu den CSS-/JS-Dateien des Leaflet-Distributionspakets (und "
"der Plugins) unter „behaviour_path“"

#: configuration/settings.cfg:27
msgid "Enable Leaflet.fullscreen plugin (fullscreen control)"
msgstr "Leaflet.fullscreen-Plugin aktivieren (Vollbildsteuerung)"

#: configuration/settings.cfg:31
msgid "Center latitude for the location map"
msgstr "Breitengrad der Mitte für die Standortkarte"

#: configuration/settings.cfg:36
msgid "Center longitude for the location map"
msgstr "Längengrad der Mitte für die Standortkarte"

#: configuration/settings.cfg:41
msgid "Accessible marker title for the location map"
msgstr "Barrierefreier Markertitel für die Standortkarte"

#: configuration/settings.cfg:45
msgid "Popup text for the location map marker"
msgstr "Popup-Text für den Marker der Standortkarte"

#: configuration/settings.cfg:49
msgid "Initial zoom level for the location map"
msgstr "Anfängliche Zoomstufe für die Standortkarte"

#: configuration/settings.cfg:54
msgid "Enable Leaflet.markercluster plugin (cluster markers on maps)"
msgstr ""
"Das Plugin „Leaflet.markercluster“ aktivieren (Marker auf Karten gruppieren)"

#: configuration/settings.cfg:58
msgid "Center latitude for the participants map"
msgstr "Breitengrad der Mitte für die Teilnehmerkarte"

#: configuration/settings.cfg:63
msgid "Center longitude for the participants map"
msgstr "Längengrad der Mitte für die Teilnehmerkarte"

#: configuration/settings.cfg:68
msgid "Initial zoom level for the participants map"
msgstr "Anfängliche Zoomstufe für die Teilnehmerkarte"

#: configuration/settings.cfg:75
msgid "Mapbox access token"
msgstr "Mapbox Zugriffs-Token"

#: configuration/settings.cfg:80
msgid "Mapbox style ID (used in styles/v1/{user}/{style})"
msgstr "Mapbox-Stil-ID (verwendet in styles/v1/{user}/{style})"

#: configuration/settings.cfg:86
msgid "Mapbox account username (Studio user)"
msgstr "Benutzername des Mapbox-Kontos (Studio-Benutzer)"
